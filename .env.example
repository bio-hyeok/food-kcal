# 복사해서 .env 로 만들고 값을 채운다. .env 는 Git 에 올리지 않는다.
DATABASE_URL=postgresql://user:password@localhost:5432/foodkcal

# AI-Hub 오픈 API 키. 명령어나 스크립트에 직접 적지 않고 여기에만 둔다.
AIHUB_API_KEY=

# 추론 서버 (server/inference). 모델 파일은 Git 에 올리지 않는다.
MODEL_DIR=C:\food-data\models_v3
# v3 모델로 정한 값. 모델을 바꾸면 ml/scripts/confidence_threshold.py 로 다시 정한다.
RECOGNITION_MIN_CONFIDENCE=0.30
RECOGNITION_TOP_K=5
MODEL_NAME=efficientnet_b0_food
MODEL_VERSION=v0.1.0
