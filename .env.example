# 복사해서 .env 로 만들고 값을 채운다. .env 는 Git 에 올리지 않는다.
DATABASE_URL=postgresql://user:password@localhost:5432/foodkcal

# AI-Hub 오픈 API 키. 명령어나 스크립트에 직접 적지 않고 여기에만 둔다.
AIHUB_API_KEY=

# 추론 서버 (server/inference). 모델 파일은 Git 에 올리지 않는다.
MODEL_DIR=C:\food-data\models_v3
# v3 모델로 정한 값. 모델을 바꾸면 ml/scripts/confidence_threshold.py 로 다시 정한다.
RECOGNITION_MIN_CONFIDENCE=0.30
RECOGNITION_TOP_K=5
# 한 사진에 여러 음식 (POST /detect). 비워 두면 /detect 만 꺼진다
DETECT_MODEL_DIR=C:\food-data\detector_v2
DETECT_MIN_CONFIDENCE=0.25
DETECT_MAX_ITEMS=15
# 실제 상차림에서 그릇 찾기 (COCO 사전학습 YOLO26n 의 bowl, ml/scripts/export_detector.py --keep-class bowl).
# 비워 두면 음식 검출 모델만 쓴다. 그릇 상자는 1순위를 미리 고르지 않는다 (DETECT_BOWL_AUTO_SELECT=false)
DETECT_BOWL_MODEL_DIR=C:\food-data\bowl_coco
DETECT_BOWL_MIN_CONFIDENCE=0.15
MODEL_NAME=efficientnet_b0_food
MODEL_VERSION=v0.1.0
